PLESK_SSH_HOST=
PLESK_SSH_PORT=22
PLESK_SSH_USER=root
PLESK_SSH_PASSWORD=
# Alternativ statt Passwort einen Key mounten und hier den Pfad angeben:
# PLESK_SSH_KEY_PATH=/run/secrets/plesk_ssh_key
PLESK_SSH_TIMEOUT=20

# Für das plesk_api_get-Tool (read-only Plesk-REST-API). Key erzeugen mit:
#   plesk bin secret_key --create -ip-address <docker-host-ip> -description "plesk-mcp"
# PLESK_API_HOST leer lassen, um PLESK_SSH_HOST mitzuverwenden (gleicher Server).
PLESK_API_HOST=
PLESK_API_PORT=8443
PLESK_API_KEY=
PLESK_API_VERIFY_SSL=true

MCP_API_KEY=
