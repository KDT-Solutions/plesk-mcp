PLESK_SSH_HOST=
PLESK_SSH_PORT=22
PLESK_SSH_USER=root
PLESK_SSH_PASSWORD=
# Alternativ statt Passwort einen Key mounten und hier den Pfad angeben:
# PLESK_SSH_KEY_PATH=/run/secrets/plesk_ssh_key
PLESK_SSH_TIMEOUT=20

# SSH-Host-Key-Verifikation (MITM-Schutz). Ohne einen der beiden Werte wird der
# Host-Key beim ersten Connect ungeprueft akzeptiert (Warnung auf stderr).
# Entweder eine gemountete known_hosts-Datei angeben ...
# PLESK_SSH_KNOWN_HOSTS=/run/secrets/plesk_known_hosts
# ... oder den erwarteten Host-Key direkt (Ausgabe von
#   ssh-keyscan -t ed25519 <host>  ->  nur "<typ> <base64>" ohne Hostnamen):
# PLESK_SSH_HOST_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...

# Für das plesk_api_get-Tool (read-only Plesk-REST-API). Key erzeugen mit:
#   plesk bin secret_key --create -ip-address <docker-host-ip> -description "plesk-mcp"
# PLESK_API_HOST leer lassen, um PLESK_SSH_HOST mitzuverwenden (gleicher Server).
PLESK_API_HOST=
PLESK_API_PORT=8443
PLESK_API_KEY=
PLESK_API_VERIFY_SSL=true

# Für das pagespeed_insights-Tool (Google PageSpeed Insights API v5).
# Ohne Key liefert Google praktisch immer HTTP 429. Key kostenlos in der Google
# Cloud Console: "PageSpeed Insights API" aktivieren -> Anmeldedaten -> API-Key,
# per API-Einschränkung nur auf die PageSpeed Insights API begrenzen.
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT=120

# wp_option_update: zusaetzlich erlaubte WordPress-Optionen (kommagetrennt),
# Standard: wp_rocket_settings, elementor_font_display
WP_OPTION_ALLOWLIST=
# WP-CLI-Phar auf dem Plesk-Server und Timeout pro Aufruf (Sekunden)
WP_CLI_PATH=/usr/local/bin/wp-standalone
WP_CLI_TIMEOUT=120

# Datei-Upload/-Verwaltung (siehe README "Datei-Upload")
# Oeffentliche Basis-URL hinter dem Reverse-Proxy, z.B. https://plesk-mcp.example.com
PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=26214400
UPLOAD_RATE_LIMIT_PER_MIN=20
UPLOAD_MAX_CONCURRENT=2
UPLOAD_MIN_FREE_MB=256
UPLOAD_TIMEOUT=300
# IP(s) des Reverse-Proxys, wie der Container sie sieht (fuer X-Forwarded-For)
UPLOAD_TRUSTED_PROXIES=
FETCH_TIMEOUT=120
VHOST_TRASH_MAX_MB=500
# Maximale Dateigroesse fuer replace_in_vhost_file(s) in Bytes (5 MB)
REPLACE_MAX_BYTES=5242880
# > 0: beim Start Papierkorb-Eintraege aller Domains loeschen, die aelter sind
VHOST_TRASH_AUTOCLEAN_DAYS=0
PLESK_HELPER_PYTHON=/usr/libexec/platform-python
PLESK_HELPER_TIMEOUT=600
AUDIT_LOG_FILE=

MCP_API_KEY=
